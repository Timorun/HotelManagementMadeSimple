SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:<port>/<database>?sslmode=require
SPRING_DATASOURCE_USERNAME=<db_user>
SPRING_DATASOURCE_PASSWORD=<db_password>
HMMS_CORS_ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app
HMMS_BOOTSTRAP_ADMIN_ENABLED=true
HMMS_BOOTSTRAP_ADMIN_USERNAME=admin
HMMS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
HMMS_BOOTSTRAP_ADMIN_PASSWORD=<strong_password>
HMMS_AUTH_COOKIE_SECURE=true
HMMS_AUTH_COOKIE_SAME_SITE=None

# Hotel
HMMS_HOTEL_NAME=Carmen Suites
HMMS_HOTEL_OWNER_EMAIL=owner@example.com
HMMS_DEFAULT_PHONE_REGION=ES

# Public pages (frontend URL used in email links) and the secret for guest preference links
HMMS_PUBLIC_BASE_URL=https://your-frontend-domain.vercel.app
HMMS_PUBLIC_TOKEN_SECRET=<long_random_string>

# Outgoing email over SMTP (e.g. Gmail with an app password, Brevo, Mailgun)
HMMS_MAIL_ENABLED=true
HMMS_MAIL_FROM=reservas@your-domain.com
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=<smtp_user>
SPRING_MAIL_PASSWORD=<smtp_password_or_app_password>

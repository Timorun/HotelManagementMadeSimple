SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:<port>/<database>?sslmode=require
SPRING_DATASOURCE_USERNAME=<db_user>
SPRING_DATASOURCE_PASSWORD=<db_password>
HMMS_CORS_ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app
HMMS_BOOTSTRAP_ADMIN_ENABLED=true
HMMS_BOOTSTRAP_ADMIN_USERNAME=admin
HMMS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
HMMS_BOOTSTRAP_ADMIN_PASSWORD=<strong_password>
HMMS_AUTH_COOKIE_SECURE=true
HMMS_AUTH_COOKIE_SAME_SITE=None

# Environment variables for the HMMS backend in production.
#
# How to use it: copy this file to `.env` in the same folder, fill in the values, and pass it
# to the container with `docker run --env-file .env ...`. `.env` is in .gitignore. Never
# commit it: it holds passwords, and this repository is public.
#
# Format rules of `docker run --env-file`:
#   - one KEY=value per line, no spaces around `=`;
#   - no quotes: they would become part of the value;
#   - comments only on their own line: a `# ...` after a value becomes part of the value.
#
# Optional settings are commented out and show their default; remove the `#` to change one.
# After editing `.env`, recreate the container (docker rm -f, then docker run). A plain
# `docker restart` keeps the old values.
#
# Every setting and its default is defined in src/main/resources/application.yml.


# =============================================================================================
# Required: the backend does not start without these
# =============================================================================================

# Selects the production settings: secure login cookie, no SQL in the logs, no sample data.
# With `prod`, every variable in this "Required" section must be set.
SPRING_PROFILES_ACTIVE=prod

# ----- Database (PostgreSQL) -----------------------------------------------------------------

# Where the database is: jdbc:postgresql://<host>:<port>/<database name>
# The backend and the pg18 container share the Docker network `hmms-network`, so <host> is the
# container name and <port> is Postgres's own port (5432), not a port published on the VM.
# For a hosted database (e.g. Neon), use its host instead and add ?sslmode=require.
SPRING_DATASOURCE_URL=jdbc:postgresql://pg18:5432/postgres

# Database user and its password (the one set with ALTER USER ... PASSWORD).
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=<database password>

# ----- Web addresses -------------------------------------------------------------------------

# The address of the frontend, as the browser shows it. Only pages served from these
# addresses may call the API. Exact scheme and host, without a path.
# Several addresses are comma-separated, e.g. https://manage-carmensuites.com,https://hmms.vercel.app
HMMS_CORS_ALLOWED_ORIGINS=https://manage-carmensuites.com

# The address of the frontend, used to build links in emails: the booking page, the guest
# preference links (unsubscribe, delete my data) and the "open request" link sent to you.
HMMS_PUBLIC_BASE_URL=https://manage-carmensuites.com

# ----- Secrets -------------------------------------------------------------------------------

# Signs the links in guest emails, so nobody can make a working unsubscribe or "delete my
# data" link for another guest. Use a long random value, e.g. the output of
#   openssl rand -hex 32
# Changing it later breaks the links in emails that were already sent.
HMMS_PUBLIC_TOKEN_SECRET=<output of openssl rand -hex 32>

# Password of the first admin account. It is only used once: on the very first start, when
# the database has no users yet, that account is created with it. Changing it here later
# does NOT change the existing password, but the prod profile still requires a value.
HMMS_BOOTSTRAP_ADMIN_PASSWORD=<strong password>


# =============================================================================================
# Recommended
# =============================================================================================

# ----- Hotel ---------------------------------------------------------------------------------

# Your email address: new booking requests and guests' data-deletion requests are sent here.
# Empty (the default) means no notifications: you only see requests in the app.
HMMS_HOTEL_OWNER_EMAIL=<your email address>

# Hotel name on the guest pages and in emails. Default: Carmen Suites
# HMMS_HOTEL_NAME=Carmen Suites

# Country assumed for phone numbers typed without a +country code (ISO code, e.g. ES, NL, GB).
# Default: ES
# HMMS_DEFAULT_PHONE_REGION=ES

# ----- Outgoing email (SMTP) -----------------------------------------------------------------

# true: really send emails (booking confirmations, request notifications, guest emails).
# false (the default): emails are only written to the backend log.
HMMS_MAIL_ENABLED=true

# Sender address guests see. With Gmail, use the Gmail address itself or an alias added in
# Gmail under Settings, Accounts, "Send mail as"; Gmail replaces any other sender address.
HMMS_MAIL_FROM=<same address as SPRING_MAIL_USERNAME>

# SMTP server and port. Gmail: smtp.gmail.com and 587 (STARTTLS). Default port: 587
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587

# SMTP login. Gmail: the full Gmail address, and an App Password (Google account, Security,
# 2-Step Verification, App passwords), not the normal Google password. Google shows it in
# four groups of four letters; enter it here without the spaces.
SPRING_MAIL_USERNAME=<gmail address>
SPRING_MAIL_PASSWORD=<app password>

# ----- First admin account (first start only, see HMMS_BOOTSTRAP_ADMIN_PASSWORD) -------------

# Login name and email of the first admin account. Defaults: admin / admin@carmensuites.local
# HMMS_BOOTSTRAP_ADMIN_USERNAME=admin
# HMMS_BOOTSTRAP_ADMIN_EMAIL=admin@carmensuites.local

# Set to false to never create an account automatically, not even on an empty database.
# Default: true
# HMMS_BOOTSTRAP_ADMIN_ENABLED=true


# =============================================================================================
# Optional: the defaults are fine
# =============================================================================================

# How long a login stays valid, in seconds. Default: 43200 (12 hours)
# HMMS_AUTH_TOKEN_TTL_SECONDS=43200

# Maximum number of logins kept at the same time; beyond it, the oldest login is ended.
# Default: 500
# HMMS_AUTH_MAX_ACTIVE_SESSIONS=500

# How often the booking.com calendars are fetched, in milliseconds. Default: 900000 (15 minutes)
# HMMS_ICAL_SYNC_INTERVAL_MS=900000

# Port the backend listens on inside the container. Default: 8080
# PORT=8080

# Login cookie flags. The prod profile already uses true / None (the cookie must be sent from
# the frontend's address to the API's address over https), so leave these out.
# HMMS_AUTH_COOKIE_SECURE=true
# HMMS_AUTH_COOKIE_SAME_SITE=None

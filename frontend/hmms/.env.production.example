# Address of the backend API, used by the frontend in production.
#
# Vite builds this value into the JavaScript during `npm run build`, so changing it needs a
# new build. On Vercel, set it under Project Settings, Environment Variables (then redeploy)
# instead of creating a .env.production file. Ends with /api; a trailing slash is ignored.
# Without it, the frontend calls /api on its own address.
VITE_API_BASE_URL=https://api.manage-carmensuites.com/api
